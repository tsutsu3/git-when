# Copy this file to .env.dev or .env.prd and fill in the values.

# The account to deploy to.
# The dev environment already sets account_id in wrangler.jsonc.
# A value in the config file wins over this variable.
CLOUDFLARE_ACCOUNT_ID=

# An API token for that account.
# Leave it empty when you sign in with `pnpm wrangler login` instead.
CLOUDFLARE_API_TOKEN=
